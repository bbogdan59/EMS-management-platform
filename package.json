{
  "name": "ems-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:css": "tailwindcss -i ./app/web/static/css/input.css -o ./app/web/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app/web/static/css/input.css -o ./app/web/static/css/app.css --watch",
    "vendor": "node scripts/vendor_assets.js",
    "build": "npm run vendor && npm run build:css",
    "mobile:types": "openapi-typescript contracts/mobile/mobile-v1.openapi.json -o contracts/mobile/mobile-v1.d.ts",
    "mobile:types:check": "npm run mobile:types -- --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "@svgdotjs/svg.js": "3.2.8",
    "echarts": "^5.5.1",
    "htmx.org": "^2.0.3",
    "leaflet": "1.9.4"
  }
}
