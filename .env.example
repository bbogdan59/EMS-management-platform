# Copiaza acest fisier in .env si completeaza valorile pentru mediul tau.
# NU comite niciodata fisierul .env real (cu secrete) in git.

# --- General ---
ENVIRONMENT=development
DEBUG=true
# Genereaza o valoare unica, de exemplu: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Europe/Bucharest

# --- Baza de date ---
DATABASE_URL=postgresql+psycopg://ems:ems@localhost:5432/ems
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
SQL_ECHO=false

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Sesiuni / cookie-uri ---
SESSION_COOKIE_NAME=ems_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=336
CSRF_COOKIE_NAME=ems_csrf

# --- Bootstrap primul admin ---
# Necesar O SINGURA DATA pentru a crea primul cont platform_admin prin /bootstrap-admin.
# Genereaza o valoare unica si sterge/roteaza variabila dupa ce ai creat contul.
BOOTSTRAP_ADMIN_TOKEN=

# --- Email (adaptor configurabil) ---
# console = scrie in logurile aplicatiei (implicit, util pentru dev/demo)
# smtp    = trimite email real, necesita SMTP_HOST/PORT/USERNAME/PASSWORD
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@ems-platform.local
SMTP_USE_TLS=true

# --- API dispozitive ---
DEVICE_CLAIM_CODE_TTL_MINUTES=15
DEVICE_TELEMETRY_BATCH_MAX_ITEMS=500
DEVICE_API_RATE_LIMIT_PER_MINUTE=120
DEVICE_MAX_PAYLOAD_BYTES=262144

# --- OPCOM ---
OPCOM_BASE_URL=https://www.opcom.ro/rapoarte-pzu-raportPIP-export-csv
OPCOM_REQUEST_TIMEOUT_SECONDS=20
OPCOM_MAX_RETRIES=4
# Daca sursa OPCOM e inaccesibila, foloseste date SINTETICE marcate explicit (vezi docs/LIMITATIONS.md)
OPCOM_USE_SYNTHETIC_FIXTURE_ON_FAILURE=false

# --- Meteo (Open-Meteo, fara autentificare) ---
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=15
WEATHER_CACHE_TTL_MINUTES=30

# --- Optimizare ---
OPTIMIZATION_HORIZON_HOURS=36
OPTIMIZATION_INTERVAL_MINUTES=15
OPTIMIZATION_SOLVER_TIMEOUT_SECONDS=30
OPTIMIZATION_SHADOW_MODE_DEFAULT=true

# --- Retentie date ---
TELEMETRY_RAW_RETENTION_DAYS=90
TELEMETRY_AGGREGATE_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=365

# --- Mod demonstrativ (simulator) ---
# NICIODATA true in productie (config.py refuza pornirea daca ENVIRONMENT=production si asta e true).
DEMO_MODE_ENABLED=false
